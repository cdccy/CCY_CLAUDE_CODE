#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

# Force recovery CLI (simple readline REPL, no Ink TUI)
if [[ "${CLAUDE_CODE_FORCE_RECOVERY_CLI:-0}" == "1" ]]; then
  exec bun --env-file=.env ./src/localRecoveryCli.ts "$@"
fi

# Default: full CLI with Ink TUI
exec bun --feature=BUDDY --env-file=.env ./src/entrypoints/cli.tsx "$@"
#exec bun --feature=BRIDGE_MODE --feature=VOICE_MODE --feature=KAIROS --feature=WORKFLOW_SCRIPTS --feature=PROACTIVE --feature=DAEMON --feature=FORK_SUBAGENT --feature=BUDDY --feature=MCP_SKILLS --feature=COORDINATOR_MODE --env-file=.env ./src/entrypoints/cli.tsx "$@"